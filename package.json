{
  "name": "orbita-desktop",
  "version": "0.1.0",
  "description": "Conversor e editor local de arquivos com menu radial",
  "main": "electron/main.cjs",
  "author": {
    "name": "Pedro Justo",
    "email": "pjusto@users.noreply.github.com"
  },
  "homepage": "https://github.com/pjusto/orbita-desktop",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron . --workspace",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/converter.cjs && npm run build",
    "dist": "npm run check && electron-builder --publish never",
    "dist:win": "npm run check && electron-builder --win --publish never",
    "dist:mac": "npm run check && electron-builder --mac --publish never",
    "dist:linux": "npm run check && electron-builder --linux AppImage --publish never",
    "dist:deb": "npm run check && electron-builder --linux deb --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "6.0.5",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.pedrojusto.orbita",
    "productName": "Orbita",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      { "ext": "jpg", "name": "Imagem para o Orbita", "role": "Editor" },
      { "ext": "jpeg", "name": "Imagem para o Orbita", "role": "Editor" },
      { "ext": "png", "name": "Imagem para o Orbita", "role": "Editor" },
      { "ext": "webp", "name": "Imagem para o Orbita", "role": "Editor" },
      { "ext": "mp4", "name": "Vídeo para o Orbita", "role": "Editor" },
      { "ext": "mov", "name": "Vídeo para o Orbita", "role": "Editor" },
      { "ext": "mp3", "name": "Áudio para o Orbita", "role": "Editor" },
      { "ext": "wav", "name": "Áudio para o Orbita", "role": "Editor" },
      { "ext": "docx", "name": "Documento para o Orbita", "role": "Editor" },
      { "ext": "xlsx", "name": "Planilha para o Orbita", "role": "Editor" }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Pedro Justo <pjusto@users.noreply.github.com>",
      "target": [
        "AppImage"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
